#!/usr/bin/env bash
# use-php <version>: make that installed PHP version the `php` for the rest of the job.
set -euo pipefail
v="${1:?usage: use-php <version, e.g. 8.3>}"
command -v "php${v}" >/dev/null || { echo "use-php: php${v} is not installed in this image" >&2; exit 1; }
dir="${RUNNER_TEMP:-/tmp}/php-${v}-bin"
mkdir -p "$dir"
for tool in php phpize php-config phpdbg; do
  [ -x "/usr/bin/${tool}${v}" ] && ln -sf "/usr/bin/${tool}${v}" "${dir}/${tool}"
done
if [ -n "${GITHUB_PATH:-}" ]; then echo "$dir" >> "$GITHUB_PATH"; else export PATH="$dir:$PATH"; fi
PATH="$dir:$PATH" php -v | head -n 1
